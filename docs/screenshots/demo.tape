# The animated tour at the top of the README.
Output demo.gif
Set Width 1280
Set Height 720
Set FontSize 13
Set Framerate 24
Set Theme "TokyoNight"
Set Shell "bash"
Set FontSize 15
Set Padding 24
Set TypingSpeed 60ms
Hide
Type "export PS1=; clear" Enter
Show
Type "hackney" Enter
Sleep 2.5s
Type "n"
Sleep 900ms
Type "n"
Sleep 900ms
Type "x"
Sleep 900ms
Type "x"
Sleep 700ms
Type "j"
Sleep 400ms
Type "j"
Sleep 1.4s
Type "k"
Sleep 300ms
Type "k"
Sleep 1s
Tab
Sleep 1.5s
Tab
Sleep 1.5s
Type "1"
Sleep 1s
Type "z"
Sleep 1.5s
Type "z"
Sleep 600ms
Type "/"
Type "terminal"
Sleep 300ms
Enter
Sleep 2s
Type "q"
